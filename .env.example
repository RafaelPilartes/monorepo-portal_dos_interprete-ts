# Copy to .env and fill in. Never commit .env (see .gitignore).
# Local values come from `pnpm exec supabase status` after `pnpm db:up`.

# ---------- Supabase (browser apps) ----------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# The API, for the writes of the apps (apps/api).
VITE_API_URL=http://localhost:3000
# Parent domain of the four apps in production, for the shared session cookie (ADR-007); empty locally.
VITE_COOKIE_DOMAIN=

# ---------- App addresses (architecture.md §8, provisional names; PC-09) ----------
SITE_URL=http://localhost:5170
REQUESTER_URL=http://localhost:5171
INTERPRETER_URL=http://localhost:5172
ADMIN_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---------- API (apps/api/src/config/env.ts) ----------
# Local values: `pnpm exec supabase status` after `pnpm db:up` (DB_URL, SERVICE_ROLE_KEY).
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only if the Auth server signs with HS256; the local stack uses ES256 keys (JWKS).
SUPABASE_JWT_SECRET=
# SITE_URL, REQUESTER_URL, INTERPRETER_URL and ADMIN_URL (above) are read too: email links.
APP_ORIGINS=http://localhost:5170,http://localhost:5171,http://localhost:5172,http://localhost:5173
# Required in production (proxies in front of the API, e.g. 1 behind Railway).
TRUST_PROXY_HOPS=
# Local email server (Mailpit): SMTP on 54325, web on 54324.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Portal dos Intérpretes <no-reply@localhost>
EMAIL_WORKER_ENABLED=true
LOG_LEVEL=info
