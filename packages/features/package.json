{
  "name": "@portal-dos-interpretes/features",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Domain screens shared by more than one app.",
  "exports": {
    ".": "./src/index.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./mocks/*": "./src/mocks/*.ts",
    "./routes": "./src/routes.ts",
