  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action of a page header or form; flat, never lifts.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>Nova solicitação</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border:0;border-radius:6px;background:#0749ac;color:#fff;font-family:'Public Sans',system-ui,sans-serif;font-size:14px;font-weight:500;cursor:pointer;transition:background-color 150ms}.ds-btn-primary:hover{background:#205bb4}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #0749ac}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions beside the primary; sheet fill, input-stroke border.",
      "html": "<button class=\"ds-btn-outline\">Cancelar</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border:1px solid #848e9f;border-radius:6px;background:#fff;color:#10192d;font-family:'Public Sans',system-ui,sans-serif;font-size:14px;font-weight:500;cursor:pointer;transition:background-color 150ms}.ds-btn-outline:hover{background:#edf0f5}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #0749ac}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost-hover",
      "description": "Low-weight links inside cards, such as 'Ver todos'.",
      "html": "<button class=\"ds-btn-ghost\">Ver todos</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:32px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:#10192d;font-family:'Public Sans',system-ui,sans-serif;font-size:12px;font-weight:500;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn-ghost:hover{background:#e9f1fb;color:#063e93}.ds-btn-ghost:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #0749ac}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "36px field on the clinical ground with a brand-blue focus ring.",
      "html": "<input class=\"ds-input\" placeholder=\"Pesquisar por código ou serviço\" aria-label=\"Pesquisar\">",
      "css": ".ds-input{height:36px;width:280px;padding:8px 12px;border:1px solid #848e9f;border-radius:6px;background:#f7f8fb;color:#10192d;font-family:'Public Sans',system-ui,sans-serif;font-size:14px}.ds-input::placeholder{color:#545d6d}.ds-input:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #0749ac}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "status-pill-waiting",
      "description": "State as dot plus word on a 10% tint; waiting, confirmed, refused, ended.",
      "html": "<div class=\"ds-pills\"><span class=\"ds-pill ds-pill-wait\"><i></i>A aguardar pagamento</span><span class=\"ds-pill ds-pill-ok\"><i></i>Confirmado</span><span class=\"ds-pill ds-pill-bad\"><i></i>Em disputa</span><span class=\"ds-pill ds-pill-end\"><i></i>Cancelado</span></div>",
      "css": ".ds-pills{display:flex;gap:8px;flex-wrap:wrap}.ds-pill{display:inline-flex;align-items:center;gap:6px;padding:2px 8px;border-radius:9999px;font-family:'Public Sans',system-ui,sans-serif;font-size:12px;font-weight:500;white-space:nowrap}.ds-pill i{width:6px;height:6px;border-radius:9999px;background:currentColor}.ds-pill-wait{color:#a65707;background:rgba(166,87,7,.1)}.ds-pill-ok{color:#19764a;background:rgba(25,118,74,.1)}.ds-pill-bad{color:#bf2222;background:rgba(191,34,34,.1)}.ds-pill-end{color:#545d6d;background:#edf0f5}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Light sidebar; the active item is a blue wash with a brand-blue icon.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegação\"><p class=\"ds-nav-app\">Área do solicitante</p><a class=\"ds-nav-item ds-active\" aria-current=\"page\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4\"/><path d=\"M16 2v4\"/><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M3 10h18\"/></svg><span>Visão geral</span></a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4\"/><path d=\"M16 2v4\"/><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M3 10h18\"/></svg><span>Pedidos</span></a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4\"/><path d=\"M16 2v4\"/><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M3 10h18\"/></svg><span>Pagamentos</span></a></nav>",
      "css": ".ds-nav{width:236px;padding:8px 10px;background:#fff;border-right:1px solid #dde1e9;font-family:'Public Sans',system-ui,sans-serif;}.ds-nav-app{margin:4px 10px 6px;font-size:11px;font-weight:500;color:#545d6d}.ds-nav-item{display:flex;align-items:center;gap:10px;height:32px;padding:0 10px;margin-bottom:2px;border-radius:6px;font-size:13px;color:rgba(16,25,45,.75);text-decoration:none;transition:background-color 150ms,color 150ms}.ds-nav-item svg{color:#545d6d;flex-shrink:0}.ds-nav-item:hover{background:#edf0f5;color:#10192d}.ds-nav-item.ds-active{background:#e9f1fb;color:#063e93;font-weight:500}.ds-nav-item.ds-active svg{color:#0749ac}.ds-nav-item:focus-visible{outline:none;box-shadow:0 0 0 2px #0749ac}"
    },
    {
      "name": "Sheet (Card)",
      "kind": "card",
      "refersTo": "card",
      "description": "White sheet, hairline border, 10px corners, near-invisible shadow.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-h\"><h3>Próximos serviços</h3><a href=\"#\">Ver todos</a></div><p>O que está à tua espera e os teus próximos serviços.</p></div>",
      "css": ".ds-card{width:420px;background:#fff;border:1px solid #dde1e9;border-radius:10px;box-shadow:0 1px 2px 0 hsl(222 47% 12% / .04);padding:24px;font-family:'Public Sans',system-ui,sans-serif;color:#10192d}.ds-card-h{display:flex;justify-content:space-between;align-items:center}.ds-card h3{margin:0;font-size:15px;font-weight:600;letter-spacing:-.01em}.ds-card a{font-size:12px;font-weight:500;color:#10192d;text-decoration:none;padding:6px 12px;border-radius:6px}.ds-card a:hover{background:#e9f1fb;color:#063e93}.ds-card p{margin:8px 0 0;font-size:14px;color:#545d6d}"
    },
    {
      "name": "Agenda List",
      "kind": "custom",
      "refersTo": "agenda-item",
      "description": "The signature: a fixed tabular day-over-time column, hairline, then what and its state.",
      "html": "<ul class=\"ds-agenda\" aria-label=\"Próximos serviços\"><li><div class=\"ds-when\"><p class=\"ds-day ds-today\">Hoje</p><p class=\"ds-time\">14:30</p></div><div class=\"ds-what\"><a href=\"#\">Consulta médica — LGA</a><p><code>PI-2026-0142</code> · Directo · 1/1 intérprete</p></div><span class=\"ds-pill ds-ok\"><i></i>Confirmado</span></li><li><div class=\"ds-when\"><p class=\"ds-day\">qua 12 nov</p><p class=\"ds-time\">09:00</p></div><div class=\"ds-what\"><a href=\"#\">Casamento — interpretação</a><p><code>PI-2026-0151</code> · Aberto · 0/2 intérpretes</p></div><span class=\"ds-pill ds-wait\"><i></i>À espera de intérpretes</span></li></ul>",
      "css": ".ds-agenda{list-style:none;margin:0;padding:0;width:560px;font-family:'Public Sans',system-ui,sans-serif;color:#10192d;font-variant-numeric:tabular-nums}.ds-agenda li{display:flex;align-items:center;gap:16px;padding:14px 0;border-top:1px solid #dde1e9}.ds-agenda li:first-child{border-top:0}.ds-when{width:76px;flex-shrink:0;line-height:1.25}.ds-when p{margin:0}.ds-day{font-size:12px;color:#545d6d}.ds-day.ds-today{color:#0749ac;font-weight:500}.ds-time{margin-top:2px!important;font-size:15px;font-weight:600;letter-spacing:-.01em}.ds-what{flex:1;min-width:0;border-left:1px solid #dde1e9;padding-left:16px}.ds-what a{font-size:14px;font-weight:500;color:#10192d;text-decoration:none}.ds-what a:hover{text-decoration:underline}.ds-what p{margin:2px 0 0;font-size:12px;color:#545d6d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-what code{font-family:'Red Hat Mono',ui-monospace,monospace}.ds-pill{display:inline-flex;align-items:center;gap:6px;padding:2px 8px;border-radius:9999px;font-size:12px;font-weight:500;white-space:nowrap}.ds-pill i{width:6px;height:6px;border-radius:9999px;background:currentColor}.ds-ok{color:#19764a;background:rgba(25,118,74,.1)}.ds-wait{color:#a65707;background:rgba(166,87,7,.1)}"
    },
    {
      "name": "Waiting List",
