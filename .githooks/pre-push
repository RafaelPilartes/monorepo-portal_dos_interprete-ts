#!/usr/bin/env bash
# Pre-push gates (claude-code-rules.md §7). Activated by `pnpm install` (core.hooksPath).
# --no-verify only in an emergency, and said in the commit message.
set -euo pipefail

zero=0000000000000000000000000000000000000000
touches_db=false
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "")"
    range="${range:+$range..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" -- packages/db/ | grep -q .; then
    touches_db=true
  fi
done

pnpm lint
pnpm typecheck
pnpm test
python3 scripts/verify.py
# db:verify exists from step F on (packages/db/scripts/verify.sh).
if [ "$touches_db" = true ] && [ -f packages/db/scripts/verify.sh ]; then
  pnpm db:verify
fi
