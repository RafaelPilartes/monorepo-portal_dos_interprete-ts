{
  "name": "@portal-dos-interpretes/root",
  "version": "0.10.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "python3 scripts/verify.py",
    "db:up": "bash packages/db/scripts/db-up.sh",
    "db:down": "bash packages/db/scripts/db-down.sh",
    "db:verify": "bash packages/db/scripts/verify.sh",
    "prepare": "git config core.hooksPath .githooks || echo 'warning: git hooks not activated (no git directory); run: git config core.hooksPath .githooks'",
    "e2e": "pnpm --filter @portal-dos-interpretes/e2e e2e",
    "db:reset": "bash packages/db/scripts/reset-local.sh",
    "db:types": "bash packages/db/scripts/gen-types.sh",
    "db:status": "bash packages/db/scripts/migrate.sh --status",
    "db:bootstrap-admin": "node packages/db/scripts/bootstrap-admin.mjs"
  },
  "devDependencies": {
    "supabase": "2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
